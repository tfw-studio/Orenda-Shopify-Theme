{{ 'customer.css' | asset_url | stylesheet_tag }}

{%- style -%}
  #shopify-section-{{ section.id }} {
    --section-padding-top: {{ section.settings.padding_top }}px;
    --section-padding-bottom: {{ section.settings.padding_bottom }}px;
  }

  #shopify-section-{{ section.id }} > .customer {
    display: flex;
    flex-direction: column;
    justify-content: space-evenly;
    width: 100%;
    gap: 40px;
    max-width: var(--page-width);
  }
  #shopify-section-{{ section.id }} > .customer > .customer__page-half {
    flex: 1;
    display: flex;
    flex-direction: column;
    justify-content: center;
    align-items: stretch;
  } 
  #shopify-section-{{ section.id }} > .customer > .customer__page-half:last-child {
    border-top: 0.1rem solid #ededed;
  }
  .customer .button {
    width: 100%;
    margin: 2rem 0;
  }
  @media screen and (min-width: 768px) {
    #shopify-section-{{ section.id }} > .customer {
      flex-direction: row;
      gap: 0;
      align-items: start;
    }
    #shopify-section-{{ section.id }} > .customer .customer__page-half:first-child {
      padding-right: 20px;
    }
    #shopify-section-{{ section.id }} > .customer .customer__page-half:last-child {
      border-top: none;
      border-left: 0.1rem solid #ededed;      
      padding-left: 20px;
    }
    #shopify-section-{{ section.id }} > .customer .customer__form-wrap {
      margin: auto;
      width: 100%;
      max-width: 500px;
    }
  }
{%- endstyle -%}

<div class="customer login page-width">
  <div class="customer__page-half section--padding">
    <div class="customer__form-wrap">
      <h1 id="recover" class="h2" tabindex="-1">{{ 'customer.recover_password.title' | t }}</h1>
      <div>
        <p>{{ 'customer.recover_password.subtext' | t }}</p>

        <form-state>
          {%- form 'recover_customer_password' -%}
            {% assign recover_success = form.posted_successfully? %}
            <div class="field">
              <input
                required="required"
                class="required{% if form.errors %} invalid{% endif %}"
                type="email"
                value=""
                name="email"
                id="RecoverEmail"
                autocorrect="off"
                autocapitalize="off"
                autocomplete="email"
                {% if form.errors %}
                  aria-invalid="true"
                  aria-describedby="RecoverEmail-email-error"
                  autofocus
                {% endif %}
                placeholder="{{ 'customer.login_page.email' | t }}"
              >
              <label class="visually-hidden" for="RecoverEmail">{{ 'customer.login_page.email' | t }}</label>
            </div>
            {%- if form.errors -%}
              <small id="RecoverEmail-email-error" class="form__message errors">
                {% render 'icon', icon: 'error' %}
                {{ form.errors.messages['form'] }}
              </small>
            {%- endif -%}

            <button class="button" type="submit">
              {{ 'customer.login_page.submit' | t }}
            </button>

            <a class="link link--underline" href="#login">
              {{ 'customer.login_page.cancel' | t }}
            </a>
          {%- endform -%}
        </form-state>
      </div>

      <h1 id="login" class="h2" tabindex="-1">{{ 'customer.login_page.title' | t }} <br /> Customer Login</h1>
      <div>
        {%- if recover_success == true -%}
          <small class="form__message" tabindex="-1" autofocus>
            {% render 'icon', icon: 'success' %}
            {{ 'customer.recover_password.success' | t }}
          </small>
        {%- endif -%}
        <form-state>
          {%- form 'customer_login' -%}
            {%- if form.errors -%}
              <p>
                <small class="form__message errors" tabindex="-1" autofocus>
                  {% render 'icon', icon: 'error' %}
                  {{ form.errors.messages['form'] }}
                </small>
              </p>
            {%- endif -%}
            
            <div class="field">        
              <input
                required="required"
                class="required{% if form.errors contains 'form' %} invalid{% endif %}"
                type="email"
                name="customer[email]"
                id="CustomerEmail"
                autocomplete="email"
                autocorrect="off"
                autocapitalize="off"
                {% if form.errors contains 'form' %}
                  aria-invalid="true"
                {% endif %}
                placeholder="{{ 'customer.login_page.email' | t }}"
              >
              <label class="visually-hidden" for="CustomerEmail">{{ 'customer.login_page.email' | t }}</span>
              {%- if form.errors contains 'form' -%}
                <small>
                  <span class="form__message errors">
                    {% render 'icon', icon: 'error' %}
                    {{ form.errors.messages['form'] }}
                  </span>
                </small>
              {%- endif -%}
            </div>

            {%- if form.password_needed -%}
              <div class="field">          
                <input
                  required="required"
                  class="required{% if form.errors contains 'form' %} invalid{% endif %}"
                  type="password"
                  value=""
                  name="customer[password]"
                  id="CustomerPassword"
                  autocomplete="current-password"
                  {% if form.errors contains 'form' %}
                    aria-invalid="true"
                  {% endif %}
                  placeholder="{{ 'customer.login_page.password' | t }}"
                >
                <label class="visually-hidden" for="CustomerPassword">{{ 'customer.login_page.password' | t }}</label>
              </div>

              <a class="link" href="#recover">{{ 'customer.login_page.forgot_password' | t }}</a>
            {%- endif -%}

            <button class="button" type="submit">{{ 'customer.login_page.sign_in' | t }}</button>
            <a href="https://buyorenda.com/tools/bundle-subscriptions?sso=silent" >Manage Subscriptions</a>

          {%- endform -%}
        </form-state>
      </div>
      
      {%- if shop.checkout.guest_login -%}
        <div>
          <hr>
          <h2>{{ 'customer.login_page.guest_title' | t }}</h2>

          {%- form 'guest_login' -%}
            <button class="button" type="submit">
              {{ 'customer.login_page.guest_continue' | t }}
            </button>
          {%- endform -%}
        </div>
      {%- endif -%}
    </div>
  </div>

  {% comment %} Create Acctount {% endcomment %}
  <div class="customer__page-half section--padding">
    <div class="customer__form-wrap">
      <h1 class="h2">{{ 'customer.register.title' | t }} <br /> Create Account</h1>
      <form-state>
        {%- form 'create_customer' -%}
          {%- if form.errors contains 'form' -%}
            <div class="form__message errors" tabindex="-1" autofocus>
              {% render 'icon', icon: 'error' %}
              <div class="rte">{{ form.errors.messages['form'] }}</div>
            </div>
          {%- endif -%}
          <div class="field">      
            <input
              type="text"
              name="customer[first_name]"
              id="RegisterForm-FirstName"
              {% if form.first_name %}value="{{ form.first_name }}"{% endif %}
              autocomplete="given-name"
              placeholder="{{ 'customer.register.first_name' | t }}"
            >
            <label class="visually-hidden" for="RegisterForm-FirstName">{{ 'customer.register.first_name' | t }}</label>
          </div>
          <div class="field">
            <input
              type="text"
              name="customer[last_name]"
              id="RegisterForm-LastName"
              {% if form.last_name %}value="{{ form.last_name }}"{% endif %}
              autocomplete="family-name"
              placeholder="{{ 'customer.register.last_name' | t }}"
            >
            <label class="visually-hidden" for="RegisterForm-LastName">{{ 'customer.register.last_name' | t }}</label>
          </div>
          <div class="field">      
            <input
              required="required"
              class="required{% if form.errors contains 'email' %} invalid{% endif %}"
              type="email"
              name="customer[email]"
              id="RegisterForm-email"
              {% if form.email %} value="{{ form.email }}"{% endif %}
              spellcheck="false"
              autocapitalize="off"
              autocomplete="email"
              aria-required="true"
              {% if form.errors contains 'email' %}
                aria-invalid="true"
                aria-describedby="RegisterForm-email-error"
              {% endif %}
              placeholder="{{ 'customer.register.email' | t }}"
            >
            <label class="visually-hidden" for="RegisterForm-email">{{ 'customer.register.email' | t }}</label>
          </div>
          {%- if form.errors contains 'email' -%}
            <span id="RegisterForm-email-error" class="form__message errors">
              {% render 'icon', icon: 'error' %}
              {{ form.errors.translated_fields['email'] | capitalize }} {{ form.errors.messages['email'] }}.
            </span>
          {%- endif -%}
          <div class="field">     
            <input
              required="required"
              class="required{% if form.errors contains 'password' %} invalid{% endif %}"
              type="password"
              name="customer[password]"
              id="RegisterForm-password"
              aria-required="true"
              {% if form.errors contains 'password' %}
                aria-invalid="true"
                aria-describedby="RegisterForm-password-error"
              {% endif %}
              placeholder="{{ 'customer.register.password' | t }}"
            >
            <label class="visually-hidden" for="RegisterForm-password">{{ 'customer.register.password' | t }}</label>
          </div>
          {%- if form.errors contains 'password' -%}
            <span id="RegisterForm-password-error" class="form__message errors">
              {% render 'icon', icon: 'error' %}
              {{ form.errors.translated_fields['password'] | capitalize }} {{ form.errors.messages['password'] }}.
            </span>
          {%- endif -%}
    
          <button class="button" type="submit">
            {{ 'customer.register.submit' | t }}
          </button>

        {%- endform -%}
      </form-state>
    </div>
  </div>
</div>

{% schema %}
{
  "name": "t:sections.main-login.name",
  "settings": [
    {
      "type": "header",
      "content": "t:sections.all.padding.header.content"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "t:sections.all.padding.padding_top.unit",
      "label": "t:sections.all.padding.padding_top.label",
      "default": 60
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "t:sections.all.padding.padding_bottom.unit",
      "label": "t:sections.all.padding.padding_bottom.label",
      "default": 60
    }
  ]
}
{% endschema %}
