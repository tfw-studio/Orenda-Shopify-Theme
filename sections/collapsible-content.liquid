{%- style -%}
  #shopify-section-{{ section.id }} {
    --section-padding-top: {{ section.settings.padding_top }}px;
    --section-padding-bottom: {{ section.settings.padding_bottom }}px;
  }
{%- endstyle -%}

{{ 'section-product-details.css' | asset_url | stylesheet_tag }}

<div class="section--padding{% if section.settings.show_divider %} section--divider{% endif %}">
  <div class="page-width{% if section.settings.narrow %} page-width--inner{% endif %}">
    <div class="title-wrapper{% if section.settings.heading == blank %} title-wrapper--no-heading{% endif %} {{ section.settings.heading_alignment }}">
      <{{ section.settings.heading_tag }} class="title {{ section.settings.heading_size }}">{{ section.settings.heading | escape }}</{{ section.settings.heading_tag }}>
    </div>

    {%- if section.blocks.size > 0 -%}
      <div class="product-details">
        {%- for block in section.blocks -%}
          {%- case block.type -%}
          {%- when 'collapsible_row' -%}
            <accordion-tab class="accordion" {{ block.shopify_attributes }}>
              <details {% if section.settings.open_first_collapsible_row and forloop.index0 == 0 %}open="open"{% endif %}>
                <summary>
                  <span class="summary__title">
                    <p class="accordion__title h3">
                      {{ block.settings.heading | default: block.settings.page.title | escape }}
                    </p>
                  </span>
                  <span class="icon icon-plus-alt"></span>
                </summary>
                <div class="accordion__content rte typeset">
                  {{ block.settings.row_content }}
                  {{ block.settings.page.content }}
                </div>
              </details>
            </accordion-tab>

            {%- when 'collapsible_video' -%}
              <accordion-tab class="accordion" {{ block.shopify_attributes }}>
                <details {% if section.settings.open_first_collapsible_row and forloop.index0 == 0 %}open="open"{% endif %}>
                  <summary>
                    <span class="summary__title">
                      <p class="accordion__title h3">
                        {{ block.settings.heading | default: block.settings.page.title | escape }}
                      </p>
                    </span>
                    <span class="icon icon-plus-alt"></span>
                  </summary>
                  <div class="accordion__content rte typeset">
                    {% if block.settings.youtube_src != blank %}
                      <div class="plyr__video-embed js-player">
                        <iframe
                          src="{{ block.settings.youtube_src }}"
                          allowfullscreen
                          allowtransparency
                          allow="autoplay"
                        ></iframe>
                      </div>
                    {% elsif block.settings.vimeo_src != blank %}
                      <div class="plyr__video-embed js-player">
                        <iframe
                          src="{{ block.settings.vimeo_src }}"
                          allowfullscreen
                          allowtransparency
                          allow="autoplay"
                        ></iframe>
                      </div>
                    {% elsif block.settings.video != blank %}
                      <video class="plyr__video-embed js-player" playsinline controls data-poster="{% if block.settings.video_poster != blank %}{{ block.settings.video_poster.src | img_url: 'grande' }}{% endif %}">
                        <source src="{{ block.settings.video.sources[1].url }}" type="video/mp4" />            
                      </video>
                    {% endif %}
                    {{ block.settings.description }}
                  </div>
                </details>
              </accordion-tab>

            {%- when 'collapsible_image' -%}
              <accordion-tab class="accordion" {{ block.shopify_attributes }}>
                <details {% if section.settings.open_first_collapsible_row and forloop.index0 == 0 %}open="open"{% endif %}>
                  <summary>
                    <span class="summary__title">
                      <p class="accordion__title h3">
                        {{ block.settings.heading | default: block.settings.page.title | escape }}
                      </p>
                    </span>
                    <span class="icon icon-plus-alt"></span>
                  </summary>
                  <div class="accordion__content rte typeset">
                    {% if block.settings.image != blank %}
                      <img src="{{ block.settings.image | img_url: 'master' }}">
                    {% endif %}
                    {{ block.settings.description }}
                  </div>
                </details>
              </accordion-tab>
        
          {%- endcase -%}
        {%- endfor -%}
      </div>
    {%- endif -%}
  </div>
</div>

<script>
  document.addEventListener('DOMContentLoaded', function() {
    const controls = ['play-large','play','volume','fullscreen']
    const players = Array.from(document.querySelectorAll('#shopify-section-{{ section.id }} .js-player')).map((p) => new Plyr(p, {controls: controls, hideControls: false, fullscreen:{iosNative:true}, vimeo:{playsinline:true, controls:false}, clickToPlay: false }));
  })
</script>
{%- assign origin = request.origin -%}

{% if request.page_type == "product" %}
{%- assign heading = section.settings.heading | downcase | strip -%}
{% if heading == "frequently asked questions" or heading == "faqs"%}
<script type="application/ld+json">
  {
    "@context": "https://schema.org"
      {%- assign faq_count = 0 -%}
      {%- capture faq_items -%}{%- endcapture -%}
      {%- for block in section.blocks -%}
      {%- assign block_type = block.type | downcase | strip -%}
        {% if block_type == "collapsible_row" %}
          {%- assign q = block.settings.heading -%}
          {%- assign a = block.settings.row_content -%}
          {%- if q != blank and a != blank -%}
            {%- assign faq_count = faq_count | plus: 1 -%}
            {%- capture one_q -%}
            {%- if faq_count > 1 -%},{%- endif -%}
            {
              "@type": "Question",
              "name": {{ q | strip | json }},
              "acceptedAnswer": { "@type": "Answer", "text": {{ a | strip_html | strip_newlines | json }} }
            }
            {%- endcapture -%}
            {%- capture faq_items -%}{{ faq_items }}{{ one_q }}{%- endcapture -%}
          {%- endif -%}
        {% endif %}
      {%- endfor -%}
      {%- if faq_count > 0 -%}
        ,"@type": "FAQPage",
        "about": { "@id": "{{ origin }}#product-{{ product.id }}" },
        "@id": "{{ origin }}#product-{{ product.id }}-faq",
        "mainEntity": [{{ faq_items }}]
      {% endif %}
  }
</script>
{% endif %}
{% endif %}

{% schema %}
{
