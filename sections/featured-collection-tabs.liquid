{%- style -%}
  #shopify-section-{{ section.id }} {
    --section-padding-top: {{ section.settings.padding_top }}px;
    --section-padding-bottom: {{ section.settings.padding_bottom }}px;
    --image-position: {{ section.settings.image_position }};
  }
{%- endstyle -%}

<link rel="stylesheet" href="{{ 'component-slider.css' | asset_url }}" media="print" onload="this.media='all'">
<link rel="stylesheet" href="{{ 'component-price.css' | asset_url }}" media="print" onload="this.media='all'">

{%- if settings.quick_view_enabled and section.settings.enable_quick_view -%}
  <link rel="stylesheet" href="{{ 'section-main-product.css' | asset_url }}" media="print" onload="this.media='all'">
  <link
    rel="stylesheet"
    href="{{ 'component-deferred-media.css' | asset_url }}"
    media="print"
    onload="this.media='all'"
  >
{%- endif -%}
<noscript>{{ 'component-slider.css' | asset_url | stylesheet_tag }}</noscript>
<noscript>{{ 'component-price.css' | asset_url | stylesheet_tag }}</noscript>

{{ 'component-product-grid.css' | asset_url | stylesheet_tag }}
{{ 'component-card.css' | asset_url | stylesheet_tag }}

{{ 'splide.min.css' | asset_url | stylesheet_tag }}
<script src="{{ 'splide.min.js' | asset_url }}" defer></script>

<div class="section--padding{% if section.settings.show_divider %} section--divider{% endif %}">
      <div class="title-wrapper{% if section.settings.heading == blank %} title-wrapper--no-heading{% endif %} {{ section.settings.heading_alignment }}">
      <{{ section.settings.heading_tag }} class="title {{ section.settings.heading_size }}">
        {{- section.settings.heading | escape -}}
      </{{ section.settings.heading_tag }}>
    </div>
<div class="page-width full-width-mobile">


    <div class="tabs" role="tablist" aria-label="Product collection tabs">
      {% for block in section.blocks %}
        <button
          id="tab-{{ block.id }}"
          role="tab"
          aria-selected="{% if forloop.index == 1 %}true{% else %}false{% endif %}"
          aria-controls="tabpanel-{{ block.id }}"
          tabindex="{% if forloop.index == 1 %}0{% else %}-1{% endif %}"
          class="tab-button {% if forloop.index == 1 %}active{% endif %}"
          data-tab-index="{{ forloop.index0 }}"
          type="button"
        >
          {{ block.settings.collection_title | default: block.settings.collection.title }}
        </button>
      {% endfor %}
    </div>

    {% for block in section.blocks %}
      {%- liquid
        assign products_to_display = block.settings.collection.all_products_count

        if block.settings.collection.all_products_count > section.settings.products_to_show
          assign products_to_display = section.settings.products_to_show
        endif
      %}
      <div
        id="SplideCarousel-{{ block.id }}"
        data-block-id="{{ block.id }}"
        class="splide carousel-block collection-tab desktop-slider slider-mobile-gutter {% if forloop.index == 1 %}active{% endif %} {% if block.settings.collection.products.size <= 3 %} hide-controls-desktop{% endif %}"
"
        role="tabpanel"
        aria-labelledby="tab-{{ block.id }}"
        data-tab-index="{{ forloop.index0 }}"
      >
        <div class="splide__track">
          <ul
            class="splide__list"
            id="Slider-{{ section.id }}"
            role="list"
            class="
              product-grid
              grid
              {% if block.settings.columns_mobile == '1' %} grid--1-col-mobile{% endif %}
              grid--2-col
              {% if block.settings.collection == blank or products_to_display == 4 and block.settings.swipe_on_mobile == false %}
                grid--2-col-tablet
                grid--4-col-desktop
              {% else %}
                grid--3-col-tablet
                {% if products_to_display == 6 %}
                  grid--3-col-desktop
                {% else %}
                  grid--4-col-desktop
                {% endif %}
              {% endif %}
              {% if products_to_display > 2 %}
                {% if block.settings.swipe_on_mobile %} slider slider--tablet{% endif %}
                {% if block.settings.swipe_on_desktop %} slider--desktop{% endif %}
              {% endif %}
            "
          >
            {%- for product in block.settings.collection.products limit: block.settings.products_to_show -%}
              <li
                id="Slide-{{ section.id }}-{{ forloop.index }}"
                class="
                  splide__slide grid__item
                  {% if products_to_display > 2 and block.settings.swipe_on_mobile or block.settings.swipe_on_desktop %}
                    slider__slide
                  {% endif %}
                "
                role="listitem"
              >
                {% render 'card-product',
                  card_product: product,
                  card_collection: block.settings.collection,
                  media_size: section.settings.image_ratio,
                  show_secondary_image: section.settings.show_secondary_image,
                  show_quick_buy: section.settings.show_quick_buy,
                  show_vendor: section.settings.show_vendor,
                  show_rating: section.settings.show_rating,
                  enable_quick_view: section.settings.enable_quick_view,
                  enable_color_swatches: section.settings.enable_color_swatches,
                  enable_countdown: section.settings.enable_countdown,
                  enable_image_fill: section.settings.enable_image_fill
                %}
              </li>
            {%- else -%}
              {%- for i in (1..4) -%}
                <li class="grid__item{% if section.settings.swipe_on_mobile %} slider__slide{% endif %}">
                  {% render 'card-product-placeholder', media_size: section.settings.image_ratio %}
                </li>
              {%- endfor -%}
            {%- endfor -%}
            {% if block.settings.enable_collection_card %}
              <div
                class="
                  promo-card splide__slide grid__item
                  {% if products_to_display > 2 and section.settings.swipe_on_mobile or section.settings.swipe_on_desktop %}
                    slider__slide
                  {% endif %}
                "
              >
                {% if block.settings.card_image != blank %}
                  {{
                    block.settings.card_image
                    | image_url: width: 800
                    | image_tag:
                      loading: 'lazy',
                      class: 'promo-card__bg',
                      widths: '400, 600, 800, 1200, 1600, 2000',
                      sizes: '(min-width: 768px) 50vw, 100vw'
                  }}
                {% endif %}
                <div class="promo-card__overlay">
                  <div class="promo-card__content">
                    <div>
                      {% if block.settings.header != blank %}
                        <h3 class="promo-card__header">{{ block.settings.header }}</h3>
                      {% endif %}

                      {% if block.settings.subheader != blank %}
                        <p class="promo-card__subheader">{{ block.settings.subheader }}</p>
                      {% endif %}
                    </div>
                    <div>
                      {% if block.settings.bottom_text != blank %}
                        <p class="promo-card__bottom">{{ block.settings.bottom_text }}</p>
                      {% endif %}

                      {% if block.settings.link_override != blank and block.settings.link_text != blank %}
                        <a href="{{ block.settings.link_override }}" class="promo-card__button">
                          {{ block.settings.link_text }}
                        </a>
                      {% endif %}
                    </div>
                  </div>
                </div>
              </div>
            {% endif %}
          </ul>
        </div>
        <use-animate data-animate="zoom-fade-small" class="media-wrapper">
          <div class="splide-progress image-animate">
            <div class="splide-progress-bar" id="progress-bar-{{ block.id }}"></div>
          </div>
        </use-animate>
      </div>
    {% endfor %}

    {%- if section.settings.show_view_all
      and section.settings.collection.all_products_count > section.settings.products_to_show
    -%}
      <div class="view-all center">
        <a
          href="{{ section.settings.collection.url }}"
          class="button"
          aria-label="{{ 'sections.featured_collection.view_all_label' | t: collection_name: section.settings.collection.title }}"
        >
          {{ 'sections.featured_collection.view_all' | t }}
        </a>
      </div>
    {%- endif -%}
  </div>
</div>

<script>
(function () {
  function initSplideTabs() {
    const splides = {};

    document.querySelectorAll('.splide.carousel-block').forEach(function (el) {
      const blockId = el.dataset.blockId;
      const progressBar = document.querySelector(`#progress-bar-${blockId}`);

      if (splides[blockId]) {
        splides[blockId].destroy();
      }

      const splide = new Splide(el, {
        type: 'slide',
        perPage: 4,
        gap: '1rem',
        drag: 'free',
        perMove: 1,
        snap: true,
        arrows: true,
        pagination: false,
        breakpoints: {
          1024: { perPage: 3 },
          768: { perPage: 2 },
          560: { perPage: 1 },
        },
      });

      function updateProgressBar() {
        const end = splide.Components.Controller.getEnd() + 1;
        const rate = Math.min((splide.index + 1) / end, 1);
        if (progressBar) {
          progressBar.style.width = `${100 * rate}%`;
        }
      }

      splide.on('mounted move dragged scrolled', updateProgressBar);
      splide.mount();
      splides[blockId] = splide;
    });

    // Tab button logic
    const tabButtons = document.querySelectorAll(".tab-button");
    const tabs = document.querySelectorAll(".collection-tab");

    tabButtons.forEach(button => {
      button.addEventListener("click", () => {
        const index = button.getAttribute("data-tab-index");

        tabButtons.forEach(btn => btn.classList.remove("active"));
        button.classList.add("active");

        tabs.forEach(tab => {
          const blockId = tab.dataset.blockId;
          const splideInstance = splides[blockId];

          if (tab.getAttribute("data-tab-index") === index) {
            tab.classList.add("active");
            if (splideInstance) {
              splideInstance.refresh();
              splideInstance.emit('move', splideInstance.index);
            }
          } else {
            tab.classList.remove("active");
          }
        });
      });
    });
  }

  function debounceInit() {
    setTimeout(() => {
      requestAnimationFrame(initSplideTabs);
    }, 100);
  }

  document.addEventListener('DOMContentLoaded', debounceInit);

  // Customizer support: re-init on section load
  document.addEventListener('shopify:section:load', debounceInit);
})();
</script>

