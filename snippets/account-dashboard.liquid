            <p class="account-dashboard__small-text">Share with a Friend:</p>
            <p class="account-dashboard__medium-text">Give $20, Get $40</p>
        </div>
                      <a href="https://buyorenda.com/pages/rewards-program-page" class="button black-btn">REFER A FRIEND</a>
        </div>
        <div class="account-dashboard__box" style="display: none;">
            <svg width="49" height="52" viewBox="0 0 49 52" fill="none" xmlns="http://www.w3.org/2000/svg">
