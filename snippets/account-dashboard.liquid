<h1 class="account-dashboard__title">Welcome, {{ customer.name }}</h1>

<span class="account-dashboard__subtitle" style="color: #6E1273;">
    <span >
    {% if customer.metafields.custom.valued_customer_since != blank %}
    Valued Customer Since {{ customer.metafields.custom.valued_customer_since | date: "%B %Y" }}
    {% endif %}
    </span>

    <span style="display: block; margin-top: 5px;">
        Your current discount level: <span class="account-dashboard__customer_discount" style="min-width: max-content; display: inline-block;"></span>
    </span>
</span>


