    </div>
    <div class="account-dashboard__box">
                 <svg width="54" height="52" viewBox="0 0 54 52" fill="none" xmlns="http://www.w3.org/2000/svg">
                <path
                    d="M11.0462 51.1998L15.3567 32.5651L0.899902 20.0314L19.9988 18.3735L27.4262 0.799805L34.8536 18.3735L53.9525 20.0314L39.4957 32.5651L43.8062 51.1998L27.4262 41.3187L11.0462 51.1998Z"
                    fill="#97D700" />
            </svg>
            <p class="account-dashboard__small-text">Orenda Rewards Points</p>
           <!-- <a href="https://buyorenda.com/pages/rewards" class="button black-btn">LEARN MORE</a> -->
                  <button id="Rise-account-page-button" class="button black-btn" style="margin-top: 10px !important;">View Your Points</button>

    </div>
</div>

<div class="grid main-page-account">
    <div class="grid__item grid__item--three-quarter">
        <div class="account-dashboard__latest-order-row">
            <h2>Latest Order</h2>

            <a href="/account?view=orders">View Order History</a>
        </div>

        {%- if customer.orders.size > 0 -%}

        {%- for order in customer.orders limit: 1 -%}
        {% render 'account-order' order: order %}
        {% endfor %}

        <a class="account-dashboard__order-history-link" href="/account?view=orders">View Order History</a>

        {%- else -%}
        <p class="account-dashboard__no-orders">{{ 'customer.orders.none' | t }}</p>
        {%- endif -%}
    </div>
</div>

<style>
    .account-dashboard__latest-order-row a {
        margin-bottom: 16px;
    }

    .account-dashboard__latest-order-row a {
        display: none;
    }

    .account-dashboard__title {
        font-weight: 600;
        font-size: 24px;
        line-height: 130%;
        text-align: center;
        letter-spacing: 0.03em;
        color: #000000;
        margin-bottom: 8px;
    }

    .account-dashboard__subtitle {
        font-weight: 600;
        font-size: 16px;
        line-height: 120%;
        text-align: center;
        letter-spacing: 0.05em;
        color: #000000;
        display: block;
        margin-bottom: 32px;
    }

    .account-dashboard__box-wrap {
        display: flex;
        flex-direction: column;
        gap: 16px
    }

    .account-dashboard__box-flex {
        display: flex;
        flex-wrap: wrap;
        flex-direction: column;
        gap: 16px
    }

    .account-dashboard__box {
        background: #FAFAFA;
        border-radius: 2px;
        display: flex;
        flex-direction: column;
        align-items: center;
        padding: 24px 16px;
        flex: 1;
        color: #000;
        text-align: center;
        font-weight: 600;
    }

    .account-dashboard__box .black-btn {
        background: #1A1B18;
        border: 1px solid #1A1B18;
        margin: 0 !important;
        padding: 1rem 1.4rem;
        text-transform: uppercase;
    }

    .account-dashboard__small-text {
        display: block;
        font-size: 16px !important;
        line-height: 130%;
        letter-spacing: 0.03em;
        margin: 15px 0 4px 0 !important;
    }

    .account-dashboard__medium-text {
        display: block;
        font-size: 20px !important;
        line-height: 130%;
        letter-spacing: 0.03em;
        margin: 0 0 12px 0 !important;
    }

    .account-dashboard__large-text {
        display: block;
        font-size: 34px !important;
        line-height: 116%;
        letter-spacing: 0.02em;
        margin: 0 0 12px 0 !important;
    }

    .account-dashboard__latest-order-row {
        margin-top: 32px !important;
    }

    .account-dashboard__latest-order-row h2,
    .recently-viewed-products .title-wrapper .title {
        font-weight: 600;
        font-size: 24px;
        line-height: 130%;
        text-align: center;
        letter-spacing: 0.03em;
        color: #000000;
    }

    .account-dashboard__order-history-link {
        font-weight: 600;
        font-size: 16px;
        line-height: 130%;
        text-align: center;
        letter-spacing: 0.03em;
        text-decoration-line: underline;
        margin-top: 32px;
        display: block;
        color: #000000;
    }

    .account-dashboard__no-orders {
        text-align: center;
    }

    @media screen and (min-width: 768px) {
        .account-dashboard__latest-order-row {
            display: flex;
            align-items: center;
            justify-content: space-between;
            margin-bottom: 24px;
        }

        .account-dashboard__latest-order-row a {
            display: block;
        }

        .account-dashboard__latest-order-row * {
            margin: 0 !important;
        }

        .account-dashboard__title {
            font-size: 30px;
            line-height: 116%;
            letter-spacing: 0.02em;
            margin-bottom: 16px;
            text-align: left;
        }

        .account-dashboard__subtitle {
            font-size: 16px;
            text-align: left;
        }

        .account-dashboard__box-flex {
            flex-direction: row;
            gap: 32px
        }

        .account-dashboard__box-wrap {
            gap: 32px;
        }

        .account-dashboard__box .black-btn {
            font-size: 14px !important;
        }

        .account-dashboard__small-text {
            font-size: 18px !important;
            margin: 30px 0 8px 0 !important;
            font-weight: 400;
        }

        .account-dashboard__medium-text {
            font-size: 22px !important;
        }

        .account-dashboard__large-text {
            margin: 0 0 26px 0 !important;
        }

        .account-dashboard__desktop-flex {
            align-items: center;
            flex-wrap: wrap;
            gap: 5px;
            margin: 0 0 20px 0 !important;
        }

        .account-dashboard__desktop-flex * {

        }

        .recently-viewed-products .title-wrapper.center {
            justify-content: start !important;
        }

        .account-dashboard__latest-order-row {
            margin-top: 0;
        }

        .account-dashboard__latest-order-row h2,
        .recently-viewed-products .title-wrapper .title {
            font-size: 32px !important;
        }

        .account-dashboard__order-history-link {
            display: none;
        }
    }

    @media screen and (min-width: 990px) {
        .account-dashboard__latest-order-row {
            margin-top: 0;
        }
    }
</style>



<script>
  function setDiscount() {
    if (window.theme && theme.Discount) {
      theme.Discount.setDiscountPercent({{ custom_disc }});
      theme.Discount.setDiscountCode('{{ discount_code }}');

      const el = document.querySelector('.account-dashboard__customer_discount');

      if (el) {
        el.textContent = '{{ discount_code }}';
      }
    }
  }

  document.addEventListener('DOMContentLoaded', setDiscount);
  document.addEventListener('rebuy:smartcart.ready', setDiscount);
  document.addEventListener('rebuy:cart.change', setDiscount);
</script>