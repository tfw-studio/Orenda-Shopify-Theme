        "image-with-text-0-0": {
          "type": "heading",
          "settings": {
            "heading": "Heart of Orenda",
            "heading_size": "h1",
            "heading_tag": "h2"
          }
        },
        "image-with-text-0-1": {
          "type": "text",
          "settings": {
            "text": "<p>As a company committed to people lifting people, Orenda International created the Heart of Orenda Fund, which to date has donated hundreds of thousands of dollars in an effort to lend a hand to the less fortunate. From the day our doors opened, we have donated one-half percent of the full retail value of our products toward making our community a better place.<\/p>",
            "text_size": "typeset2",
            "secondary_color": true
          }
        },
        "image-with-text-0-2": {
          "type": "text",
          "settings": {
            "text": "<p>The Heart of Orenda Fund has recently supported:<\/p><ul><li><a href=\"https:\/\/www.smiletrain.org\" target=\"_blank\" title=\"https:\/\/www.smiletrain.org\">Smile Train<\/a><\/li><li><a href=\"https:\/\/wck.org\" target=\"_blank\" title=\"https:\/\/wck.org\">World Central Kitchen<\/a><\/li><li><a href=\"https:\/\/www.marbridge.org\" target=\"_blank\" title=\"https:\/\/www.marbridge.org\">Marbridge<\/a><\/li><li><a href=\"https:\/\/jausa.ja.org\/about\/index\" target=\"_blank\" title=\"https:\/\/jausa.ja.org\/about\/index\">Junior Achievement<\/a><\/li><li><a href=\"https:\/\/www.doctorswithoutborders.org\" target=\"_blank\" title=\"https:\/\/www.doctorswithoutborders.org\">Doctors Without Borders<\/a><\/li><\/ul>",
            "text_size": "typeset",
            "secondary_color": true
          }
        },
        "image-with-text-0-3": {
