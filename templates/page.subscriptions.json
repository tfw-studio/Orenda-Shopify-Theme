    "7c896a02-ce08-4ed9-b00d-046b80780900": {
      "type": "rich-text",
      "blocks": {
        "template--14846180851793__7c896a02-ce08-4ed9-b00d-046b80780900-1685121574a4f17ec9-0": {
          "type": "heading",
          "settings": {
            "heading": "How it works",
            "heading_size": "h2",
            "heading_tag": "h2"
          }
        },
        "template--14846180851793__7c896a02-ce08-4ed9-b00d-046b80780900-1685121574a4f17ec9-1": {
          "type": "text",
          "settings": {
            "text": "<p><strong>01. Find what's right for you.<\/strong> Browse our best sellers and choose the formulas that fit where you are right now. Not sure where to start? Our most loved subscriptions are listed below.<\/p><p><em><strong>02. We handle the rest.<\/strong><\/em><strong> <\/strong>Your formulas arrive monthly, right on schedule. Staying consistent stops being something you have to think about.<\/p><p><em><strong>03. We give you a heads-up.<\/strong><\/em> Five days before every order processes, you'll get a friendly reminder. Time to add something, skip a month, pause, or make any changes before anything ships. No surprises. Ever.<\/p>",
            "text_size": "typeset3",
            "secondary_color": false
          }
        },
        "template--14846180851793__7c896a02-ce08-4ed9-b00d-046b80780900-1685121574a4f17ec9-2": {
          "type": "button",
