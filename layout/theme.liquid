    <!-- Custom Discount Logic -->
    {% liquid
      assign custom_disc = 0
      assign discount_code = ''

      if customer
        if customer.tags contains 'Discount_Autoship20%' and customer.tags contains 'Active Subscriber'
          assign custom_disc = 20
          assign discount_code = 'ACTIVE_SUBSCRIBER20'
        endif
        if customer.tags contains 'Discount_Affiliate20%'
          assign custom_disc = 20
          assign discount_code = 'AFFILIATE20PERCENT'
        endif
        if customer.tags contains 'Discount_Affiliate30%'
          assign custom_disc = 30
          assign discount_code = 'AFFILIATE30PERCENT'
        endif
        if customer.tags contains 'Discount_Manager40%'
          assign custom_disc = 40
          assign discount_code = 'MANAGER40PERCENT'
        endif
      endif
    %}
    <script defer="defer">
      function setDiscount() {
        if(window.theme && theme.Discount) {
          theme.Discount.setDiscountPercent({{ custom_disc }})
          theme.Discount.setDiscountCode('{{ discount_code }}')
        }
      }
      document.addEventListener("DOMContentLoaded", setDiscount);
      document.addEventListener('rebuy:smartcart.ready', setDiscount);
      document.addEventListener('rebuy:cart.change', setDiscount);
    </script>
    <!-- End Custom Discount Logic -->

    <!-- Klaviyo integration script from Consentmo GDPR app -->
<script id="consentmo-klaviyo-conditional-load">
(function() {
  'use strict';
  var KLAVIYO_URL = 'https://static.klaviyo.com/onsite/js/NLurPQ/klaviyo.js?company_id=NLurPQ';
  var loaded = false;

  function loadKlaviyo() {
    if (loaded) return;
    loaded = true;
    document.cookie = "__kla_off=;expires=Thu, 01 Jan 1970 00:00:00 GMT;path=/";
    var s = document.createElement('script');
    s.src = KLAVIYO_URL;
    s.async = true;
    document.head.appendChild(s);
    console.log('[Consentmo-Klaviyo] Marketing consent granted — Klaviyo loaded');
  }

  function blockKlaviyo() {
    document.cookie = "__kla_off=true;path=/";
    console.log('[Consentmo-Klaviyo] Marketing not consented — Klaviyo blocked');
  }

  // Default: block tracking
  blockKlaviyo();

  // Also block the auto-injected script via MutationObserver
  var blockedSrcs = [];
  var observer = new MutationObserver(function(mutations) {
    for (var m = 0; m < mutations.length; m++) {
      var nodes = mutations[m].addedNodes;
      for (var n = 0; n < nodes.length; n++) {
        var node = nodes[n];
        if (node.tagName === 'SCRIPT') {
          var src = node.src || '';
          if (src.toLowerCase().indexOf('klaviyo.com') !== -1) {
            if (blockedSrcs.indexOf(src) === -1) blockedSrcs.push(src);
            node.parentNode && node.parentNode.removeChild(node);
            console.log('[Consentmo-Klaviyo] Blocked auto-injected script:', src);
          }
        }
      }
    }
  });
  observer.observe(document.documentElement, { childList: true, subtree: true });

  // Listen for ConsentMo consent
  document.addEventListener('consentmoSignal_onLoad', function(e) {
    var signal = e.detail || { isActive: false };

    if (!signal.isActive) {
      // ConsentMo not active for this visitor — allow Klaviyo
      observer.disconnect();
      loadKlaviyo();
    } else {
      // ConsentMo active — wait for consent decision
      document.addEventListener('consentmoSignal', function(ev) {
        var prefs = ev.detail && ev.detail.preferences;
        if (!prefs) return;

        if (prefs.marketing) {
          observer.disconnect();
          loadKlaviyo();
        } else {
          blockKlaviyo();
        }
      });
    }
  });

  // Also check cookie-based consent for immediate page loads
  var match = document.cookie.match(/(?:^|;\s*)cookieconsent_preferences_disabled=([^;]*)/);
  if (match) {
    var disabled = decodeURIComponent(match[1]);
    if (disabled.indexOf('marketing') === -1) {
      // Marketing is NOT disabled — consent was previously granted
      observer.disconnect();
      loadKlaviyo();
    }
  }
})();
</script>

