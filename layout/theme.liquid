    <script>
      document.addEventListener('DOMContentLoaded', function () {
        const observer = new MutationObserver(() => {
          const form = document.querySelector('[data-testid="klaviyo-form-Wh2bT3"]');
          if (form) {
            const visibilityObserver = new IntersectionObserver(
              (entries, visObserver) => {
                entries.forEach((entry) => {
                  if (entry.isIntersecting) {
                    const linksWithoutAria = form.querySelectorAll('a:not([aria-label])');
                    linksWithoutAria.forEach((link) => {
                      link.setAttribute('aria-label', `${link.text} (Opens in new tab)`);
                    });
                    visObserver.disconnect(); // Stop observing once it's handled
                    mutationObserver.disconnect(); // Optional: stop mutation observer too
                  }
                });
              },
              {
                threshold: 0.1, // Adjust as needed (0 = any visibility, 1 = fully visible)
              }
            );

            visibilityObserver.observe(form);
          }
        });

        const mutationObserver = observer;
        mutationObserver.observe(document.body, { childList: true, subtree: true });
      });
    </script>

