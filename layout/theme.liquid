    {%- comment -%} === Custom Fonts: Axiforma + Aeonik Extended + Alexandria (Option 2) === {%- endcomment -%}
    <!-- Preload self-hosted Axiforma + Aeonik Extended -->
    <link rel="preload" as="font" href="{{ 'axiforma-book.woff2' | asset_url }}" type="font/woff2" crossorigin>
    <link rel="preload" as="font" href="{{ 'axiforma-regular.woff2' | asset_url }}" type="font/woff2" crossorigin>
    <link rel="preload" as="font" href="{{ 'axiforma-semibold.woff2' | asset_url }}" type="font/woff2" crossorigin>
    <link rel="preload" as="font" href="{{ 'aeonikextended-medium.woff2' | asset_url }}" type="font/woff2" crossorigin>

    <!-- Alexandria (Google Fonts): Light 300, Regular 400, Bold 700 -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Alexandria:wght@300;400;700&display=swap" rel="stylesheet">

    <style>
      /* =========================
         Self-hosted families
         ========================= */
      /* Axiforma: Book(300) / Regular(400) / SemiBold(600) */
      @font-face{
        font-family:"Axiforma";
        src:url("{{ 'axiforma-book.woff2' | asset_url }}") format("woff2"),
            url("{{ 'axiforma-book.woff'  | asset_url }}") format("woff");
        font-weight:300;
        font-style:normal;
        font-display:swap;
      }
      @font-face{
        font-family:"Axiforma";
        src:url("{{ 'axiforma-regular.woff2' | asset_url }}") format("woff2"),
            url("{{ 'axiforma-regular.woff'  | asset_url }}") format("woff");
        font-weight:400;
        font-style:normal;
        font-display:swap;
      }
      @font-face{
        font-family:"Axiforma";
        src:url("{{ 'axiforma-semibold.woff2' | asset_url }}") format("woff2"),
            url("{{ 'axiforma-semibold.woff'  | asset_url }}") format("woff");
        font-weight:600;
        font-style:normal;
        font-display:swap;
      }

      /* Aeonik Extended: Medium(500) */
      @font-face{
        font-family:"Aeonik Extended";
        src:url("{{ 'aeonikextended-medium.woff2' | asset_url }}") format("woff2"),
            url("{{ 'aeonikextended-medium.woff'  | asset_url }}") format("woff");
        font-weight:500;
        font-style:normal;
        font-display:swap;
      }

      /* =========================
         CSS variables (families)
         ========================= */
      :root{
        /* Base families */
        --font-body-family: "Axiforma", -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, Arial, sans-serif;
        --font-heading-family: "Alexandria", -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, Arial, sans-serif;

        /* Specific roles */
        --font-extended-family: "Aeonik Extended", "Alexandria", "Axiforma", -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, Arial, sans-serif;
        --font-alexandria-family: "Alexandria", -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, Arial, sans-serif;

        /* Defaults per strategy */
        --font-body-weight: 300;  /* Axiforma Book for body copy */
        --font-heading-weight: 400; /* Alexandria Regular for H2+ by default */

        /* Common line-heights */
        --lh-tight: 1.1;
        --lh-head: 1.2;
        --lh-body: 1.6;
      }

      /* =========================
         Global defaults
         ========================= */
      body{
        font-family: var(--font-body-family);
        font-weight: var(--font-body-weight);
        line-height: var(--lh-body);
      }

      /* =========================
         Headings mapping (Option 2)
         ========================= */
      /* H1: Aeonik Extended Medium */
      {% if template.name == 'index' %}
      h1, .h1{
        font-family: var(--font-extended-family);
        font-weight: 500;
        line-height: var(--lh-tight);
        letter-spacing: -0.01em; /* subtle optical kerning for extended */
      }
      {% else %}
      h1, .h1{
        font-family: var(--font-heading-family);
        font-weight: 500;
        line-height: var(--lh-tight);
        letter-spacing: -0.01em; /* subtle optical kerning for extended */
      }
      {% endif %}

      /* H2–H4: Alexandria Regular */
      h2, .h2,
      h3, .h3,
      h4, .h4{
        font-family: var(--font-heading-family);
        font-weight: 400;
        line-height: var(--lh-head);
        letter-spacing: 0;
      }

      /* =========================
         Subheading / Tagline
         (Alexandria Light, uppercase)
         ========================= */
      .subheading,
      .tagline{
        font-family: var(--font-alexandria-family);
        font-weight: 300;
        text-transform: uppercase;
        letter-spacing: .12em;
        line-height: 1.3;
        opacity: .9; /* optional: softer tone */
      }

      /* =========================
         Eyebrow / Label
         (Alexandria Regular, small/uppercase)
         ========================= */
      .eyebrow,
      .label{
        font-family: var(--font-alexandria-family);
        font-weight: 400;
        font-size: 1.6rem;
        line-height: 1.2;
        letter-spacing: .09em;
        text-transform: uppercase;
        -webkit-font-smoothing: antialiased;
        -moz-osx-font-smoothing: grayscale;
        font-smooth: never;
      }

      /* =========================
         Buttons (Axiforma SemiBold)
         ========================= */
      .button,
      button,
      [type="button"],
      [type="submit"],
      .shopify-payment-button__button{
        font-family: "Axiforma", system-ui, -apple-system, "Segoe UI", Roboto, Arial, sans-serif !important;
        font-weight: 600 !important; /* SemiBold */
        letter-spacing: 0.15em;
        text-transform: none; /* keep brand voice; set to uppercase if desired */
      }

      /* Utility families */
      .font-extended, .font-extended *{ font-family: var(--font-extended-family) !important; font-weight: 500; letter-spacing: .01em; }
      .font-alexandria, .font-alexandria *{ font-family: var(--font-alexandria-family) !important; }

      /* Optional helpers for Alexandria weights */
      .font-alexandria--light{ font-weight: 300 !important; }
      .font-alexandria--regular{ font-weight: 400 !important; }
      .font-alexandria--bold{ font-weight: 700 !important; }

      * {
        font-synthesis: none;
        -webkit-font-smoothing: antialiased;
        -moz-osx-font-smoothing: grayscale;
      }
    </style>
    {%- comment -%} === End Custom Fonts (Option 2) === {%- endcomment -%}

