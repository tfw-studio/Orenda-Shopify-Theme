    {% comment %} START - Update Product Price and Subtotal on Rebuy Reactivate Landing Page {% endcomment %}
    <script>
      (function () {
        if (window.location.pathname !== '/apps/rebuy/recharge/subscription/reactivate') return;

        const interval = setInterval(updateReactivatePrice, 100);

        let originalPrice = null;

        function toCent(amount) {
          const str = amount.toString();
          const [int] = str.split('.');

          return Number(
            amount
              .toFixed(2)
              .replace('.', '')
              .padEnd(int.length === 1 ? 3 : 4, '0')
          );
        }

        function updateReactivatePrice() {
          const priceElem = document.querySelector(
            '.rebuy-reactivate-landing__utility-block.rebuy-product-price .rebuy-money'
          );
          const subtotalElem = document.querySelector(
            '.rebuy-reactivate-landing__utility-block.rebuy-reactivate-landing__subtotal .rebuy-money'
          );
          const quantityElem = document.querySelector('.rebuy-widget__item-quantity-widget-label');

          if (!priceElem || !subtotalElem || !quantityElem) return;

          if (!originalPrice) originalPrice = toCent(parseInt(priceElem.innerText.slice(1)));

          const quantity = parseInt(quantityElem.innerText);

          const priceCents = originalPrice;
          const subtotalCents = priceCents * quantity;

          const discountPrice = theme.Discount.applyDiscount(priceCents, 20);
          const discountSubtotal = theme.Discount.applyDiscount(subtotalCents, 20);

          priceElem.innerText = theme.Currency.formatMoney(discountPrice, window.shopSettings.moneyFormat);
          subtotalElem.innerText = theme.Currency.formatMoney(discountSubtotal, window.shopSettings.moneyFormat);
        }
      })();
    </script>
    {% comment %} END - Update Product Price and Subtotal on Rebuy Reactivate Landing Page {% endcomment %}
